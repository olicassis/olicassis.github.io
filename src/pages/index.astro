---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Panel from "../components/Panel.astro";
import Tag from "../components/Tag.astro";
import SectionHeader from "../components/SectionHeader.astro";
import portrait from "../assets/me_manga.jpg";
import { site } from "../site";

const featured = (await getCollection("projects", (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

// Placeholder skills. Replace with your own.
const skills = ["typescript", "python", "astro", "sql", "git", "linux"];
---
<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="oc-eyebrow">// hello, world</p>
        <h1 class="hero-name">Hi, I'm {site.name}.</h1>
        <p class="hero-role mono">{site.role}</p>
        <p class="hero-tagline">{site.tagline}</p>
        <div class="row hero-ctas">
          <Button href="/projects/">see projects</Button>
          <Button href={site.linkedin} variant="secondary" external>linkedin</Button>
        </div>
      </div>
      <div class="hero-art" aria-hidden="false">
        <div class="hero-tone screentone" aria-hidden="true"></div>
        <div class="hero-disc">
          <Image src={portrait} alt="Manga-style drawing of Elias in a straw hat and a leaf-green tunic" width={480} widths={[240, 480, 720]} sizes="(min-width: 720px) 360px, 70vw" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" id="about">
    <SectionHeader eyebrow="about" title="About me" />
    <div class="about">
      <div class="prose">
        <p>Placeholder. A short paragraph about who you are, what you work on today and what drives you.</p>
        <p>Placeholder. A second paragraph about how you learn: the courses, books and side projects you log on this site.</p>
      </div>
      <div>
        <p class="oc-eyebrow">// skills</p>
        <ul class="row list-reset skills">{skills.map((s) => <li><Tag>{s}</Tag></li>)}</ul>
      </div>
    </div>
  </section>

  <div class="band">
    <section class="wrap section">
      <SectionHeader eyebrow="projects" title="Featured work" />
      <div class="grid">
        {featured.map((p) => (
          <Panel href={p.data.repo ?? p.data.url ?? "/projects/"} label="featured">
            <h3 class="panel-title">{p.data.title}</h3>
            <p class="panel-text">{p.data.summary}</p>
            <ul class="row list-reset">{p.data.tags.map((t) => <li><Tag>{t}</Tag></li>)}</ul>
          </Panel>
        ))}
      </div>
      <div><Button href="/projects/" variant="ghost">all projects →</Button></div>
    </section>
  </div>

  <section class="wrap section" id="contact">
    <SectionHeader eyebrow="contact" title="Say hello" lede="The best way to reach me for now is LinkedIn." />
    <div><Button href={site.linkedin} external>message me on linkedin</Button></div>
  </section>
</Base>

<style>
  .hero { border-bottom: 2px solid var(--border); overflow: hidden; }
  .hero-inner { display: grid; gap: var(--space-8); align-items: center; padding-block: var(--space-12); }
  @media (min-width: 820px) { .hero-inner { grid-template-columns: 1.2fr 1fr; padding-block: var(--space-16); } }
  .hero-text { display: grid; gap: var(--space-4); min-width: 0; }
  .hero-name { margin: 0; font: 400 clamp(40px, 7vw, 64px)/1.06 var(--font-display); letter-spacing: -0.01em; }
  .hero-role { margin: 0; font-size: 15px; color: var(--link); }
  .hero-tagline { margin: 0; max-width: 46ch; color: var(--ink-muted); }
  .hero-ctas { gap: var(--space-4); margin-top: var(--space-2); }
  .hero-art { position: relative; justify-self: center; width: min(100%, 360px); }
  .hero-tone { position: absolute; inset: -24px -24px auto auto; width: 70%; height: 70%; }
  .hero-disc { position: relative; aspect-ratio: 1; max-width: 100%; border-radius: var(--radius-full); background: var(--olive); border: 2px solid var(--border); box-shadow: var(--shadow-panel); overflow: hidden; }
  .hero-disc :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .about { display: grid; gap: var(--space-8); }
  @media (min-width: 820px) { .about { grid-template-columns: 2fr 1fr; } }
  .skills { list-style: none; margin-top: var(--space-3); }
  .panel-title { margin: 0 0 var(--space-2); font: 600 20px/28px var(--font-sans); }
  .panel-text { margin: 0 0 var(--space-4); font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
  ul.row { list-style: none; }
</style>
