---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProgressItem from '../components/ProgressItem.astro';

const items = (await getCollection('progress', (i) => !i.data.draft)).sort(
  (a, b) =>
    a.data.value - b.data.value ||
    (b.data.finished ?? '').localeCompare(a.data.finished ?? '') ||
    a.data.title.localeCompare(b.data.title),
);
const learning = items.filter((i) => i.data.kind !== 'book');
const books = items.filter((i) => i.data.kind === 'book');
const done = items.filter((i) => i.data.value >= 100).length;
---

<Base
  title="Progress"
  description="Courses, certifications and books, with how far along each one is."
>
  <section class="wrap section">
    <SectionHeader
      level={1}
      eyebrow="progress"
      title="What I am learning"
      lede="Courses, certifications and books, with how far along each one is."
    />
    <p class="summary mono">
      {done} of {items.length} finished
    </p>
    <div class="cols">
      <div>
        <h2 class="col-title">Courses and certifications</h2>
        <ul class="list-reset">
          {learning.map((i) => (
            <ProgressItem {...i.data} />
          ))}
        </ul>
      </div>
      <div>
        <h2 class="col-title">Books</h2>
        <ul class="list-reset">
          {books.map((i) => (
            <ProgressItem {...i.data} />
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
<style>
  .summary {
    margin: 0;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .cols {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 820px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cols > div {
    min-width: 0;
  }
  .col-title {
    margin: 0 0 var(--space-2);
    font: 500 13px/16px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
