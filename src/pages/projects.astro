---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import Tag from "../components/Tag.astro";
import SectionHeader from "../components/SectionHeader.astro";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => b.data.year - a.data.year);
---
<Base title="Projects" description="Things I have built.">
  <section class="wrap section">
    <SectionHeader level={1} eyebrow="projects" title="Projects" lede="Things I have built, newest first." />
    <div class="grid">
      {projects.map((p) => (
        <Panel href={p.data.repo ?? p.data.url} label={p.data.featured ? "featured" : undefined}>
          <p class="year mono">{p.data.year}</p>
          <h2 class="panel-title">{p.data.title}</h2>
          <p class="panel-text">{p.data.summary}</p>
          <ul class="row list-reset">{p.data.tags.map((t) => <li><Tag>{t}</Tag></li>)}</ul>
        </Panel>
      ))}
    </div>
  </section>
</Base>
<style>
  .year { margin: 0 0 var(--space-1); font-size: 13px; line-height: 18px; color: var(--ink-muted); }
  .panel-title { margin: 0 0 var(--space-2); font: 600 20px/28px var(--font-sans); }
  .panel-text { margin: 0 0 var(--space-4); font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
  ul.row { list-style: none; }
</style>
