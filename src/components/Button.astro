---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
}
const { href, variant = 'secondary', external = false } = Astro.props;
---

<a
  class:list={['oc-btn', variant === 'primary' && 'oc-btn-primary']}
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <slot />
  <span class="oc-btn-arrow" aria-hidden="true">
    {external ? '↗' : '→'}
  </span>
</a>
