---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';

interface Props {
  kind: 'course' | 'certification' | 'book';
  title: string;
  by?: string;
  value: number;
  finished?: string;
  url?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { kind, title, by, value, finished, url, image, imageAlt } = Astro.props;
const pct = Math.max(0, Math.min(100, value));
const done = pct >= 100;
const status = done ? finished : kind === 'book' ? 'reading' : 'in progress';
// Stand-in mark until an image is added: issuer initials, or the book's title initials.
const initials = ((kind === 'book' ? title : by) ?? title)
  .split(/[\s(]+/)
  .filter((w) => /^[A-Z]/.test(w))
  .slice(0, 3)
  .map((w) => w[0])
  .join('');
const cta = kind === 'book' ? 'about the book' : 'see certificate';
---

<li>
  <Card href={url} external={!!url} class:list={['oc-learn', `oc-learn-${kind}`, 'reveal']}>
    <span class="oc-learn-media">
      {image ? (
        <Image
          src={image}
          alt={imageAlt ?? ''}
          width={480}
          sizes="(min-width: 720px) 240px, 64px"
        />
      ) : (
        <span aria-hidden="true">{initials}</span>
      )}
    </span>
    <span class="oc-learn-text">
      <span class="oc-meta">
        <span class="oc-meta-kind">{kind}</span>
        {status &&
          (done ? <span>{status}</span> : <span class="oc-tag oc-tag-leaf">{status}</span>)}
      </span>
      <span class="oc-title">{title}</span>
      {by && <span class="oc-sub">{by}</span>}
      {!done && pct > 0 && (
        <span
          class="oc-learn-track"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={pct}
          aria-label={`${title}: ${pct}% read`}
        >
          <span class="oc-learn-fill" style={`width:${pct}%`}></span>
        </span>
      )}
      {url && (
        <span class="oc-card-cta">
          {cta} <span aria-hidden="true">↗</span>
        </span>
      )}
    </span>
  </Card>
</li>
