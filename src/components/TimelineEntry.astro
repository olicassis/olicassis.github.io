---
interface Props {
  kind: 'work' | 'study';
  title: string;
  org: string;
  start: string;
  end?: string;
  location?: string;
}
const { kind, title, org, start, end, location } = Astro.props;
const current = !end;
---

<li class:list={['oc-tl-item', 'reveal', current && 'oc-tl-current']}>
  <span class="oc-tl-dot" aria-hidden="true"></span>
  <div class="oc-glass oc-card oc-tl-card">
    <p class="oc-meta">
      <span class="oc-meta-kind">{kind === 'study' ? 'education' : 'work'}</span>
      <span>
        {start} — {end ?? 'now'}
      </span>
      {current && <span class="oc-tag oc-tag-leaf">now</span>}
    </p>
    <h4 class="oc-title">{title}</h4>
    <p class="oc-sub">
      {org}
      {location && ` · ${location}`}
    </p>
    <div class="oc-text">
      <slot />
    </div>
  </div>
</li>
