---
import Card from './Card.astro';
import { site } from '../site';

interface Props {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  url?: string;
}
const { title, authors, venue, year, url } = Astro.props;
---

<li>
  <Card href={url} external={!!url} class="reveal">
    <p class="oc-meta">
      <span class="oc-meta-kind">{year}</span>
      <span>{venue}</span>
    </p>
    <h3 class="oc-title">{title}</h3>
    <p class="oc-sub">
      {authors.map((a, i) => (
        <>
          {a === site.fullName ? <strong>{a}</strong> : a}
          {i < authors.length - 1 && ', '}
        </>
      ))}
    </p>
    {url && (
      <span class="oc-card-cta">
        read the paper <span aria-hidden="true">↗</span>
      </span>
    )}
  </Card>
</li>
