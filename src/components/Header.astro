---
import { nav, site } from '../site';
import BerryMark from './BerryMark.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="oc-header wrap">
  <div class="oc-glass oc-bar">
    <a class="oc-mark" href="/#top">
      <BerryMark />
      {site.handle}
    </a>
    <nav class="oc-nav-strip" aria-label="Sections">
      <ul class="oc-nav list-reset">
        {nav.map((item) => (
          <li>
            <a href={`/#${item.id}`} data-spy={item.id}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
<script is:inline>
  // Scroll-spy: marks the nav link of the section in view and keeps it visible in the
  // phone nav strip. The links work without it.
  document.addEventListener('DOMContentLoaded', () => {
    const links = [...document.querySelectorAll('[data-spy]')];
    const strip = document.querySelector('.oc-nav-strip');
    if (!('IntersectionObserver' in window) || !strip) return;
    const mark = (id) =>
      links.forEach((a) => {
        if (a.dataset.spy !== id) return a.removeAttribute('aria-current');
        a.setAttribute('aria-current', 'true');
        strip.scrollTo({ left: a.offsetLeft - strip.clientWidth / 2 + a.clientWidth / 2 });
      });
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && mark(e.target.id)),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    links.forEach((a) => {
      const section = document.getElementById(a.dataset.spy);
      if (section) io.observe(section);
    });
  });
</script>
