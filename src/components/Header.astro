---
import { nav, site } from "../site";
import ThemeToggle from "./ThemeToggle.astro";
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="wordmark" href="/">{site.handle}</a>
    <nav aria-label="Main">
      <ul class="nav list-reset">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
<style>
  .site-header { border-bottom: 2px solid var(--border); background: var(--surface); }
  .site-header-inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); padding-block: var(--space-3); }
  .wordmark { font: 400 22px/28px var(--font-display); color: var(--ink); text-decoration: none; margin-right: auto; }
  .nav { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; }
  .nav a { display: block; padding: var(--space-2); font: 500 14px/18px var(--font-mono); color: var(--ink-muted); text-decoration: none; }
  .nav a:hover { color: var(--ink); background: var(--husk); }
  .nav a[aria-current="page"] { color: var(--on-accent); background: var(--leaf); }
</style>
