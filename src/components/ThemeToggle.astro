<button class="oc-theme" type="button" id="theme-toggle" aria-label="Switch colour theme">
  <span aria-hidden="true">◐</span>
  <span data-theme-name>auto</span>
</button>
<script is:inline>
  // Theme toggle: auto, light, dark. The choice is kept in localStorage.
  (() => {
    const order = ['auto', 'light', 'dark'];
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const name = btn.querySelector('[data-theme-name]');
    let current = 'auto';
    try {
      current = localStorage.getItem('theme') || 'auto';
    } catch {}
    const apply = (t) => {
      if (t === 'auto') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', t);
      name.textContent = t;
    };
    apply(current);
    btn.addEventListener('click', () => {
      current = order[(order.indexOf(current) + 1) % order.length];
      try {
        localStorage.setItem('theme', current);
      } catch {}
      apply(current);
    });
  })();
</script>
